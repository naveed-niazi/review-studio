{
  "name": "review-studio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "check": "npm run test && npm run build && npm run test:ui",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron .",
    "package:mac": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "package:dir": "npm run build && electron-builder --dir",
    "prepack": "npm run build",
    "test:ui": "node test/ui-check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@playwright/test": "^1.51.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.468.0",
    "prettier": "^3.9.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "vite": "^6.3.5"
  },
  "description": "Local pull request reviews with Claude Code, GitHub CLI, and a responsive desktop workspace.",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "author": "Review Studio",
  "bin": {
    "review-studio": "bin/review-studio.js"
  },
  "files": [
    "server",
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "desktop",
    "build/icon.png",
    "build/trayTemplate.png",
    "build/icon.icns"
  ],
  "build": {
    "appId": "dev.reviewstudio.app",
    "productName": "Review Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "dist/**/*",
      "build/icon.png",
      "build/trayTemplate.png",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "identity": null
    },
    "dmg": {
      "title": "Review Studio",
      "contents": [
        {
          "x": 130,
          "y": 160
        },
        {
          "x": 410,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "artifactName": "Review-Studio-${version}-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naveed-niazi/review-studio.git"
  },
  "homepage": "https://github.com/naveed-niazi/review-studio#readme",
  "bugs": {
    "url": "https://github.com/naveed-niazi/review-studio/issues"
  },
  "keywords": [
    "code-review",
    "pull-request",
    "claude-code",
    "github",
    "electron",
    "developer-tools",
    "local-first"
  ]
}
